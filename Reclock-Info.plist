<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE stays YES).
	     Only keys that build settings can't express live here. -->
	<!-- Brand display face (SIL OFL). Both path forms listed so registration survives
	     either flat or folder-preserving resource copies; misses are ignored. -->
