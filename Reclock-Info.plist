	<array>
		<string>Fraunces-Black.ttf</string>
		<string>Fraunces-SemiBold.ttf</string>
		<string>Fonts/Fraunces-Black.ttf</string>
		<string>Fonts/Fraunces-SemiBold.ttf</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.reclock.ios.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>reclock</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
